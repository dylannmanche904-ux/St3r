-- RÉTRACTION
local collapsed = false

toggle.Activated:Connect(function()
    collapsed = not collapsed
    content.Visible = not collapsed
    frame.Size = collapsed
        and UDim2.fromOffset(150,30)
        or UDim2.fromOffset(220,205)
    toggle.Text = collapsed and "+" or "−"
end)

-- DÉPLACEMENT AU DOIGT
local dragging = false
local dragStart
local startPos
local dragInput

top.InputBegan:Connect(function(inputObject)
    if inputObject.UserInputType == Enum.UserInputType.Touch
    or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = inputObject.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(inputObject)
    if dragging and (
        inputObject.UserInputType == Enum.UserInputType.Touch
        or inputObject.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = inputObject.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(inputObject)
    if inputObject.UserInputType == Enum.UserInputType.Touch
    or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- TRADUCTION
translate.Activated:Connect(function()
    if input.Text == "" then return end

    translate.Text = "..."
    task.spawn(function()
        local url = "https://api.mymemory.translated.net/get?q="
            ..HttpService:UrlEncode(input.Text)
            .."&langpair=fr|"..languages[selected][2]

        local ok,response = pcall(function()
            return requestFunc({Url=url,Method="GET"})
        end)

        if ok and response and response.StatusCode == 200 then
            local success,data = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)

            if success and data.responseData then
                output.Text = data.responseData.translatedText or "Erreur"
            else
                output.Text = "Erreur traduction"
            end
        else
            output.Text = "Erreur connexion"
        end

        translate.Text = "TRADUIRE"
    end)
end)

copy.Activated:Connect(function()
    if output.Text ~= "" and setclipboard then
        setclipboard(output.Text)
        copy.Text = "COPIÉ !"
        task.wait(1)
        copy.Text = "COPIER POUR RÔLE"
    end
end)
